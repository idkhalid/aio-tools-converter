---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The requested converter page does not exist."
  canonicalPath="/404"
>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24">
    <div
      class="rounded-3xl border border-slate-200 bg-white px-6 py-12 text-center shadow-[0_8px_24px_rgba(15,23,42,0.05)] sm:px-12"
    >
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-indigo-600">404</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
        Page not found
      </h1>
      <p class="mx-auto mt-4 max-w-md leading-7 text-slate-500">
        The converter may have moved or is not available yet.
      </p>
      <a
        class="mt-8 inline-flex min-h-11 items-center justify-center rounded-xl bg-indigo-500 px-5 font-semibold text-white shadow-sm transition-colors hover:bg-indigo-600"
        href="/">View all tools</a
      >
    </div>
  </section>
</BaseLayout>
