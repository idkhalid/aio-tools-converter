---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The requested converter page does not exist."
  canonicalPath="/404"
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-semibold text-sky-700">404</p>
    <h1 class="mt-3 text-4xl font-black text-slate-950">Page not found</h1>
    <p class="mt-4 text-slate-600">The converter may have moved or is not available yet.</p>
    <a class="primary-button mt-8" href="/">View all tools</a>
  </section>
</BaseLayout>
