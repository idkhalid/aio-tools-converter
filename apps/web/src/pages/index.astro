---
import { getRoutableTools } from "@aio-converter/tool-registry";
import ToolCard from "../components/ToolCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { appConfig } from "../lib/app-config";

const tools = getRoutableTools();

const imageTools = tools
  .filter((t) => t.category === "image")
  .map((t) => ({ title: t.title, href: t.seo.canonicalPath }));
const pdfTools = tools
  .filter((t) => t.category === "pdf")
  .map((t) => ({ title: t.title, href: t.seo.canonicalPath }));
const videoTools = tools
  .filter((t) => t.category === "video")
  .map((t) => ({ title: t.title, href: t.seo.canonicalPath }));
const documentTools = tools
  .filter((t) => t.category === "document")
  .map((t) => ({ title: t.title, href: t.seo.canonicalPath }));
---

<BaseLayout
  title={`${appConfig.name} — Private file conversion tools`}
  description="Convert images, PDFs, videos, and documents with local-first processing and transparent privacy."
  canonicalPath="/"
>
  <section
    class="border-b border-slate-200/70 bg-gradient-to-b from-indigo-50/70 via-[#f7f8fc] to-[#f7f8fc] py-14 sm:py-20"
  >
    <div class="relative z-10 mx-auto max-w-[1200px] px-4 text-center sm:px-6">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-white px-3 py-1 text-xs font-semibold text-indigo-700 shadow-sm sm:mb-7 sm:px-4 sm:py-1.5 sm:text-sm"
      >
        Private by design &bull; No install &bull; Easy to use
      </div>

      <h1
        class="mx-auto max-w-4xl text-4xl font-black leading-[1.08] tracking-tight text-slate-950 sm:text-6xl"
      >
        Useful converters.<br />
        <span class="text-indigo-600">With clear privacy.</span>
      </h1>

      <p
        class="mx-auto mt-5 max-w-2xl text-base leading-7 text-slate-500 sm:mt-6 sm:text-lg sm:leading-8"
      >
        Convert, compress, edit, and download files without extra applications.
      </p>

      <div class="relative mx-auto mt-8 max-w-2xl sm:mt-10">
        <div
          class="relative flex w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_24px_rgba(15,23,42,0.05)] transition focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-500/10"
        >
          <div class="pl-4 sm:pl-6 text-slate-400 shrink-0">
            <svg class="size-5 sm:size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            id="tool-search"
            class="w-full min-w-0 flex-1 bg-transparent py-4 sm:py-5 pl-3 sm:pl-4 pr-4 sm:pr-6 text-base sm:text-lg text-slate-900 placeholder:text-slate-400 focus:outline-none text-ellipsis"
            placeholder="Search tools — PDF to Word, compress image..."
            aria-label="Search tools"
          />
          <div class="pr-3 hidden sm:block">
            <kbd
              class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400"
              >/</kbd
            >
          </div>
        </div>
      </div>

      <div class="mt-7 flex flex-wrap justify-center gap-2.5 sm:mt-8 sm:gap-3">
        {
          tools.map((t) => (
            <a
              href={t.seo.canonicalPath}
              class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-indigo-300 hover:text-indigo-600 sm:px-5"
            >
              {t.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200/70 bg-white/70">
    <div class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6 sm:py-20">
      <div class="mb-8 flex flex-col items-start gap-4 sm:mb-10 sm:flex-row sm:items-end">
        <div>
          <span class="text-sm font-bold uppercase tracking-wider text-indigo-600"
            >Explore Tools</span
          >
          <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
            Explore by category
          </h2>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <CategoryCard
          title="Image Tools"
          description="Convert, compress, resize, and optimize images."
          tools={imageTools}
          iconBgClass="bg-indigo-50"
          iconTextClass="text-indigo-500"
        >
          <svg slot="icon" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
        </CategoryCard>

        <CategoryCard
          title="PDF Tools"
          description="Edit and convert documents without extra software."
          tools={pdfTools}
          iconBgClass="bg-rose-50"
          iconTextClass="text-rose-500"
        >
          <svg slot="icon" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
        </CategoryCard>

        <CategoryCard
          title="Video & Audio"
          description="Convert and optimize media directly from your browser."
          tools={videoTools}
          iconBgClass="bg-teal-50"
          iconTextClass="text-teal-500"
        >
          <svg slot="icon" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </CategoryCard>

        <CategoryCard
          title="Document Tools"
          description="Convert DOCX to PDF through isolated temporary jobs."
          tools={documentTools}
          iconBgClass="bg-amber-50"
          iconTextClass="text-amber-500"
        >
          <svg slot="icon" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
            ></path>
          </svg>
        </CategoryCard>
      </div>
    </div>
  </section>

  <section id="tools" class="mx-auto max-w-[1200px] scroll-mt-8 px-4 py-12 sm:px-6 sm:py-20">
    <div class="mb-8 sm:mb-10">
      <span class="text-sm font-bold uppercase tracking-wider text-indigo-600">All tools</span>
      <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
        Choose a converter
      </h2>
      <p class="mt-3 text-slate-500">
        Start with one of the available reference tools. Processing stays local whenever supported.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" id="tools-grid">
      {
        tools.map((tool) => (
          <div
            class="tool-card-item h-full"
            data-title={tool.title.toLowerCase()}
            data-category={tool.category}
          >
            <ToolCard tool={tool} />
          </div>
        ))
      }

      <div
        id="search-empty"
        class="col-span-full hidden rounded-2xl border-2 border-dashed border-slate-200 py-12 text-center text-slate-500"
      >
        No tools found matching your search.
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 pb-12 sm:px-6 sm:pb-20">
    <div
      class="grid gap-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_8px_24px_rgba(15,23,42,0.05)] sm:grid-cols-3 sm:gap-8 sm:p-8"
    >
      <div>
        <h2 class="text-lg font-bold text-slate-950">Local where practical</h2>
        <p class="mt-2 text-sm leading-6 text-slate-500">
          Image, PDF, and media reference tools run in isolated browser workers.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-bold text-slate-950">No silent fallback</h2>
        <p class="mt-2 text-sm leading-6 text-slate-500">
          A local tool will never upload your file if the browser cannot process it.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-bold text-slate-950">Automatic cleanup</h2>
        <p class="mt-2 text-sm leading-6 text-slate-500">
          Temporary server jobs (like DOCX to PDF) are canceled, expired, and deleted by design.
        </p>
      </div>
    </div>
  </section>

  <script>
    // Client-side search filtering
    const searchInput = document.getElementById("tool-search") as HTMLInputElement;
    const toolsGrid = document.getElementById("tools-grid");
    const toolCards = document.querySelectorAll(".tool-card-item");
    const emptyState = document.getElementById("search-empty");

    if (searchInput && toolsGrid && emptyState) {
      document.addEventListener("keydown", (e) => {
        if (e.key === "/" && document.activeElement !== searchInput) {
          e.preventDefault();
          searchInput.focus();
        }
      });

      searchInput.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        let hasVisible = false;

        toolCards.forEach((card) => {
          const htmlCard = card as HTMLElement;
          const title = htmlCard.dataset.title || "";
          const category = htmlCard.dataset.category || "";

          if (title.includes(query) || category.includes(query)) {
            htmlCard.style.display = "";
            hasVisible = true;
          } else {
            htmlCard.style.display = "none";
          }
        });

        if (hasVisible) {
          emptyState.classList.add("hidden");
        } else {
          emptyState.classList.remove("hidden");
        }
      });
    }
  </script>
</BaseLayout>
