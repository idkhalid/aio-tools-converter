---
import type { ToolDefinition } from "@aio-converter/tool-core";

const { tool } = Astro.props as { tool: ToolDefinition };
---

<a
  href={tool.seo.canonicalPath}
  class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-sky-300 hover:shadow-md"
>
  <div class="flex items-start justify-between gap-3">
    <span
      class="rounded-lg bg-sky-100 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-sky-800"
      >{tool.category}</span
    >
    {tool.status === "beta" && <span class="text-xs font-medium text-slate-500">Beta</span>}
  </div>
  <h3 class="mt-5 text-lg font-bold text-slate-950 group-hover:text-sky-700">{tool.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{tool.shortDescription}</p>
  <span class="mt-5 font-semibold text-sky-700"
    >Open tool <span aria-hidden="true">&rarr;</span></span
  >
</a>
