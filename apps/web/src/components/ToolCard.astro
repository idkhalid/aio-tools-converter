---
import type { ToolDefinition } from "@aio-converter/tool-core";

const { tool } = Astro.props as { tool: ToolDefinition };
---

<a
  href={tool.seo.canonicalPath}
  class="group flex h-full flex-col rounded-2xl border border-slate-200/90 bg-white p-5 shadow-[0_2px_8px_rgba(15,23,42,0.04)] transition-colors hover:border-indigo-300 hover:shadow-[0_8px_20px_rgba(79,70,229,0.08)]"
>
  <div class="flex items-start justify-between gap-3">
    <span
      class="rounded-lg bg-indigo-50 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-indigo-700"
      >{tool.category}</span
    >
    {tool.status === "beta" && <span class="text-xs font-medium text-slate-500">Beta</span>}
  </div>
  <h3 class="mt-5 text-lg font-bold text-slate-950 group-hover:text-indigo-700">{tool.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">{tool.shortDescription}</p>
  <span class="mt-5 text-sm font-semibold text-indigo-600"
    >Open tool <span aria-hidden="true">&rarr;</span></span
  >
</a>
