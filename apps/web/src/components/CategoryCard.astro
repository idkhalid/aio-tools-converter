---
interface ToolInfo {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  tools: ToolInfo[];
  iconBgClass: string;
  iconTextClass: string;
}

const { title, description, tools, iconBgClass, iconTextClass } = Astro.props;
---

<div
  class="flex flex-col rounded-2xl border border-slate-200/90 bg-white p-6 shadow-[0_2px_8px_rgba(15,23,42,0.04)] sm:p-7"
>
  <div
    class={`mb-4 grid size-10 place-items-center rounded-xl ${iconBgClass} ${iconTextClass} sm:mb-5 sm:size-11`}
  >
    <slot name="icon" />
  </div>
  <h3 class="flex items-center gap-2 text-lg font-bold text-slate-950 sm:text-xl">
    {title}
    <span aria-hidden="true" class="text-base text-indigo-400 sm:text-lg">&rarr;</span>
  </h3>
  <p class="mt-2 mb-6 flex-1 text-sm leading-6 text-slate-500 sm:mt-3 sm:mb-7">
    {description}
  </p>
  <ul class="flex flex-col gap-3 border-t border-slate-100 pt-5 sm:gap-4">
    {
      tools.map((tool) => (
        <li>
          <a
            href={tool.href}
            class="text-sm font-semibold text-slate-700 hover:text-indigo-600 transition-colors"
          >
            {tool.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
