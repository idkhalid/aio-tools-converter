---
interface ToolInfo {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  tools: ToolInfo[];
  iconBgClass: string;
  iconTextClass: string;
}

const { title, description, tools, iconBgClass, iconTextClass } = Astro.props;
---

<div
  class="flex flex-col rounded-3xl border border-slate-100 bg-white p-6 sm:p-8 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)]"
>
  <div
    class={`grid size-10 sm:size-12 place-items-center rounded-2xl ${iconBgClass} ${iconTextClass} mb-4 sm:mb-6`}
  >
    <slot name="icon" />
  </div>
  <h3 class="text-lg sm:text-xl font-bold text-slate-950 flex items-center gap-2">
    {title}
    <span aria-hidden="true" class="text-indigo-400 text-base sm:text-lg">&rarr;</span>
  </h3>
  <p class="mt-2 sm:mt-3 text-xs sm:text-sm leading-6 text-slate-500 mb-6 sm:mb-8 flex-1">
    {description}
  </p>
  <ul class="flex flex-col gap-3 sm:gap-4 border-t border-slate-100 pt-5 sm:pt-6">
    {
      tools.map((tool) => (
        <li>
          <a
            href={tool.href}
            class="text-sm font-semibold text-slate-700 hover:text-indigo-600 transition-colors"
          >
            {tool.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
