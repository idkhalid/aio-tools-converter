---
import { appConfig } from "../lib/app-config";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  imagePath?: string;
}

const { title, description, canonicalPath, imagePath = "/favicon.svg" } = Astro.props;
const canonical = new URL(canonicalPath, appConfig.url);
const image = new URL(imagePath, appConfig.url);
const appMark = appConfig.name.charAt(0).toUpperCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={appConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body class="bg-[#f7f8fc] text-slate-950 antialiased">
    <a
      href="#main-content"
      class="fixed left-3 top-3 z-50 -translate-y-24 rounded-lg bg-slate-950 px-4 py-2 text-white focus:translate-y-0"
      >Skip to content</a
    >
    <header class="border-b border-slate-200/80 bg-white/95 shadow-[0_1px_2px_rgba(15,23,42,0.03)]">
      <div
        class="mx-auto flex max-w-[1200px] items-center justify-between gap-4 px-4 py-3.5 sm:px-6"
      >
        <a href="/" class="flex min-w-0 items-center gap-3 font-bold text-slate-950 no-underline">
          <span
            class="grid size-9 shrink-0 place-items-center rounded-xl bg-indigo-500 text-white shadow-sm"
            aria-hidden="true">{appMark}</span
          >
          <span class="truncate text-[0.95rem] tracking-tight sm:text-base">{appConfig.name}</span>
        </a>
        <nav aria-label="Main navigation">
          <a
            href="/#tools"
            class="inline-flex min-h-10 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-semibold text-slate-700 transition-colors hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
            >All tools</a
          >
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="mt-16 border-t border-slate-200/80 bg-white">
      <div
        class="mx-auto flex max-w-[1200px] flex-col gap-4 px-4 py-8 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p class="max-w-xl leading-6">
          &copy; {new Date().getFullYear()}
          {appConfig.name}. Local tools keep files in your browser; temporary server jobs are
          cleaned up automatically.
        </p>
        <a
          href="/#tools"
          class="w-fit font-semibold text-indigo-600 hover:text-indigo-700 hover:underline"
          >Browse tools</a
        >
      </div>
    </footer>
  </body>
</html>
