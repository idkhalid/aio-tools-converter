# Frontend build-time origins. Deployment builds must use exact HTTPS staging origins.
PUBLIC_APP_NAME=AIO Converter
PUBLIC_APP_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8080

# API CORS allowlist. Use exact origins only; wildcard origins are rejected.
API_ALLOWED_ORIGINS=http://localhost:4321
API_ADDR=:8080
# Optional bearer token for trusted local monitoring. Leave empty to disable /metrics.
API_METRICS_TOKEN=

# Ephemeral API job limits. API TTL/process/download timeouts must not exceed 15m.
API_JOB_ROOT=/work/jobs
API_JOB_TTL=15m
API_MAX_CONCURRENT_JOBS=1
API_MAX_QUEUED_JOBS=8
API_MAX_UPLOAD_BYTES=262144000
API_PROCESS_TIMEOUT=10m
API_DOWNLOAD_TIMEOUT=10m
API_SHUTDOWN_TIMEOUT=15s
API_PROCESSOR_SOCKET=/run/aio-office/office.sock
# Inject a real non-empty value through the staging secret manager; never commit it.
API_PROCESSOR_TOKEN=

# LibreOffice runner. Keep the socket and job root on tmpfs as configured by Compose.
OFFICE_SOCKET_PATH=/run/aio-office/office.sock
OFFICE_JOB_ROOT=/work/office-jobs
LIBREOFFICE_BIN=soffice
OFFICE_MAX_INPUT_BYTES=52428800
OFFICE_MAX_OUTPUT_BYTES=268435456
OFFICE_PROCESS_TIMEOUT=10m
OFFICE_MAX_CONCURRENT_JOBS=1
OFFICE_SHUTDOWN_TIMEOUT=15s
